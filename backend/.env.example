# ─────────────────────────────────────────────────────────────
# FalconMed Elite v4 — Backend environment
# Copy to .env (never commit .env). On Render, set these in
# the service's Environment tab instead.
# ─────────────────────────────────────────────────────────────

# Neon connection string (Dashboard → Connection Details → pooled)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Shared key the queue machine / kiosk sends in the X-Queue-Key header
QUEUE_API_KEY=change-me-too

# Comma-separated list of front-end origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,https://falconmed.app,https://dashboard.falconmed.app

# Business settings
TIMEZONE=Asia/Dubai
WAIT_TARGET_MIN=5

# Password given to every demo account by `npm run seed`
DEMO_PASSWORD=Demo@2026

PORT=5000
NODE_ENV=development
