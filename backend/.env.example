# ─────────────────────────────────────────────────────────────
# FalconMed Elite v5 — Backend environment
# Copy to .env (never commit .env). On Render, set these in
# the service's Environment tab instead.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ─────────────────────────────────────────────────────────────

# Neon connection string (Dashboard → Connection Details → pooled)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# At least 32 random characters in production (the server refuses to start otherwise).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Public URL of the dashboard: used in emails and Stripe redirects. https:// in production.
APP_URL=http://localhost:5173

# Comma-separated list of front-end origins allowed by CORS
CORS_ORIGINS=http://localhost:5173
# Optional: a regex for preview deployments you own, e.g.
#   ^https://falconmed-[a-z0-9-]+-yourteam\.vercel\.app$
# Leave empty unless you need it: anyone can create a *.vercel.app site.
CORS_PREVIEW_PATTERN=

# Business settings
TIMEZONE=Asia/Dubai
WAIT_TARGET_MIN=5

# ── Email (Resend: https://resend.com) ────────────────────────
# Without a key, emails are printed to the log instead of sent.
# The sender's domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=FalconMed Elite <no-reply@falconmed.app>

# ── Billing (Stripe) — see docs/BILLING.md ────────────────────
# Prefer a restricted key (rk_…) with the permissions listed in docs/BILLING.md.
# Without a key, billing endpoints answer 503 and trials cannot convert.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# ── Demo (optional) ───────────────────────────────────────────
# Password given to every demo account by `npm run seed`
DEMO_PASSWORD=Demo@2026
# Show the demo accounts on the login screen. Set false on a customer-only deployment.
DEMO_LOGIN=true
# Demo sites only. When true, the demo organisations are rebuilt on start-up
# if their newest ticket is more than 12 hours old (never touches real
# organisations). Leave false for a real deployment.
DEMO_AUTO_REFRESH=false
# Legacy shared kiosk key. Reaches DEMO organisations only; customers create
# their own keys in Settings → Queue keys. Leave empty if you have no demo.
QUEUE_API_KEY=

PORT=5000
NODE_ENV=development
