# Base URL of the FalconMed Elite API (no trailing slash, no /api).
# Also sets the Content Security Policy's connect-src at build time.
# Local:      http://localhost:5000
# Production: https://falconmed-backend.onrender.com
VITE_API_URL=http://localhost:5000

# Shown on the Billing page for the Enterprise plan.
VITE_SALES_EMAIL=sales@falconmed.app

# Legal pages (/terms, /privacy). Have the text reviewed for your jurisdiction.
VITE_LEGAL_ENTITY=FalconMed
VITE_LEGAL_EMAIL=privacy@falconmed.app
VITE_LEGAL_UPDATED=1 November 2026
